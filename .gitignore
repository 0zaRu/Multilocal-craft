# Los MUNDOS no se suben a GitHub (sus términos no permiten usar el repo como almacén de partidas).
# Se guarda todo lo demás (configuración, plugins y sus datos). El mundo lo copia el anfitrión en
# local (en central: copias nocturnas en ~/backups/minecraft, con niveles diaria/semanal/mensual).
server 2025/world/
server 2025/world_nether/
server 2025/world_the_end/
# Los registros del servidor tampoco: cambian en cada arranque y harían que siempre hubiera "algo nuevo"
server 2025/logs/
# Copias de jars antiguos que guarda actualizar.py
server 2025/.upgrade-backup/
# Log de la prueba de arranque de actualizar.py
server 2025/logs/actualizar-prueba.log
# Datos que genera Geyser Standalone al ejecutarse
server 2025/geyser/*
!server 2025/geyser/config.yml
!server 2025/geyser/Geyser-Standalone.jar
# Estado del servidor en marcha (lo crea scripts/iniciar)
server 2025/.estado-servidor
# Temporales que se generan en cada arranque
server 2025/plugins/spark/tmp/
server 2025/logs/*.log.gz
server 2025/logs/geyser-bajo-demanda.log
server 2025/.paper/
# Cachés de Python
__pycache__/
# Temporales de Essentials
server 2025/plugins/Essentials/*.tmp.bin
# Operaciones lanzadas desde la app de control (scripts/panel.py lanzar)
server 2025/logs/panel-operacion.log
server 2025/.panel-operacion
# Compilación de la app de control
app-movil/build/
server 2025/.panel-bateria
# Diario temporal de SQLite (la base de vínculos linked-players.db sí se sube: viaja con el mundo)
server 2025/plugins/floodgate/linked-players.db-journal

# Ajustes propios de cada anfitrión fijo (plantilla: docker-compose.central.ejemplo.yml)
docker-compose.central.yml

# Datos que guardan IPs de jugadores: se quedan en el anfitrión (y en sus copias locales), nunca en git
server 2025/plugins/Essentials/userdata/
server 2025/copias-cuentas/
server 2025/banned-ips.json
server 2025/plugins/LoginSecurity/

# Seguridad (2026-11-12): nunca a git
# - Contraseñas de AuthMe (cifradas, pero no se publican) y sus registros (llevan IPs)
server 2025/plugins/AuthMe/authme.db
server 2025/plugins/AuthMe/*.db*
server 2025/plugins/AuthMe/logs/
server 2025/plugins/AuthMe/authme.log
# - Clave de Floodgate: con ella cualquiera podría hacerse pasar por un jugador de Bedrock. Cada anfitrión la suya.
server 2025/plugins/floodgate/key.pem
server 2025/geyser/key.pem
# - Ficheros que el contenedor itzg genera con la contraseña de RCON
server 2025/.rcon-cli.env
server 2025/.rcon-cli.yaml
# - Ajustes de exposición del anfitrión fijo (central)
docker-compose.central-publico.yml
exponer-minecraft.sh
